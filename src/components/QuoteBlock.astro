---
interface Props {
  text: string;
  source?: string | undefined;
  author?: string;
  featured?: boolean;
}

const { text, source, author, featured = false } = Astro.props;
const cite = [author, source].filter(Boolean).join(', ');
---

<figure class:list={['quote', { featured }]}>
  <blockquote><p>{text}</p></blockquote>
  {cite && <figcaption>— {cite}</figcaption>}
</figure>

<style>
  .quote {
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent, var(--rule));
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--ink);
  }

  blockquote p::before {
    content: '“';
  }

  blockquote p::after {
    content: '”';
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .featured {
    border-left-width: 4px;
    padding: 1.25rem 1.5rem;
  }

  .featured blockquote p {
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
  }
</style>
