---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STANCE_LABELS } from '../lib/content';
import { MAP, axisBreaks, getMapData, labelOffset, ticks } from '../lib/map';
import { formatLifespan, formatYear } from '../lib/format';
import { thinkerUrl } from '../lib/url';

const { rows, nodes, edges, height, connectionsOf } = await getMapData();
const nodeById = new Map(nodes.map((n) => [n.id, n]));
const ideologyName = new Map(rows.map((r) => [r.ideology.id, r.ideology.data.name]));

// Everything the panel needs, resolved at build time.
const data = {
  labels: STANCE_LABELS,
  thinkers: Object.fromEntries(
    nodes.map((n) => {
      const d = n.thinker.data;
      return [
        n.id,
        {
          name: d.name,
          dates: formatLifespan(d),
          ideology: ideologyName.get(d.primary.id),
          color: n.color,
          summary: d.summary,
          url: thinkerUrl(n.id),
          connections: connectionsOf(n.id).map((c) => ({
            id: c.other,
            name: nodeById.get(c.other)!.thinker.data.name,
            stance: c.stance,
            note: c.note,
          })),
        },
      ];
    }),
  ),
};

const degree = (id: string) => edges.filter((e) => e.a === id || e.b === id).length;
---

<BaseLayout
  title="Map of ideas"
  description="A timeline of every thinker in the Hall, showing who learned from whom, who stood together and who argued back."
>
  <section class="intro container">
    <p class="eyebrow">Map of ideas</p>
    <h1>Who learned from whom, and who argued back</h1>
    <p class="lede">
      Each dot is a thinker, placed by the year they were born and the school they belong to. The lines
      show how ideas travelled: solid for influence, dashed for argument. Tap a thinker to light up
      their conversations.
    </p>
  </section>

  <div class="container map-layout" data-pagefind-ignore>
    <div class="map-col">
      <div class="filters" role="group" aria-label="Show lines">
        <button type="button" class="chip influence" aria-pressed="true" data-kind="influence">
          <span class="swatch" aria-hidden="true"></span>Influence
        </button>
        <button type="button" class="chip agreed" aria-pressed="true" data-kind="agreed">
          <span class="swatch" aria-hidden="true"></span>Stood together
        </button>
        <button type="button" class="chip argued" aria-pressed="true" data-kind="argued">
          <span class="swatch" aria-hidden="true"></span>Argued
        </button>
      </div>

      <div class="scroller">
        <svg
          class="map"
          viewBox={`0 0 ${MAP.width} ${height}`}
          role="group"
          aria-label="Timeline map of thinkers and their connections"
        >
          <g class="axis" aria-hidden="true">
            {
              ticks.map((t) => (
                <g>
                  <line x1={t.x} x2={t.x} y1={MAP.top - 8} y2={height - MAP.bottom} />
                  <text x={t.x} y={MAP.top - 18}>
                    {t.label}
                  </text>
                </g>
              ))
            }
            {
              axisBreaks.map((b) => (
                <path
                  class="break"
                  d={`M${b.x1 + 3} ${MAP.top - 28} l5 5 l-5 5 l5 5 M${b.x2 - 8} ${MAP.top - 28} l5 5 l-5 5 l5 5`}
                />
              ))
            }
          </g>

          <g class="rows" aria-hidden="true">
            {
              rows.map((r, i) => (
                <g style={`--row: ${r.ideology.data.color}`}>
                  {i % 2 === 0 && (
                    <rect
                      class="band"
                      x="0"
                      y={r.y - MAP.rowHeight / 2}
                      width={MAP.width}
                      height={MAP.rowHeight}
                    />
                  )}
                  <text
                    class:list={['row-label', { right: r.labelRight }]}
                    x={r.labelRight ? MAP.width - 10 : 10}
                    y={r.y - MAP.rowHeight / 2 + 14}
                  >
                    {r.ideology.data.name}
                  </text>
                </g>
              ))
            }
          </g>

          <g class="edges" aria-hidden="true">
            {edges.map((e) => <path class:list={['edge', e.kind]} d={e.path} data-a={e.a} data-b={e.b} />)}
          </g>

          <g class="nodes">
            {
              nodes.map((n) => (
                <a
                  href={thinkerUrl(n.id)}
                  class="node"
                  data-id={n.id}
                  style={`--dot: ${n.color}`}
                  aria-label={`${n.thinker.data.name}, born ${formatYear(n.thinker.data.born, n.thinker.data.bornCirca)}, ${ideologyName.get(n.thinker.data.primary.id)}, ${degree(n.id)} connections`}
                >
                  <circle class="halo" cx={n.x} cy={n.y} r="14" />
                  <circle class="dot" cx={n.x} cy={n.y} r="6.5" />
                  <text
                    x={n.x}
                    y={n.labelY}
                    text-anchor={n.anchor}
                    dx={labelOffset(n.anchor)}
                  >
                    {n.label}
                  </text>
                </a>
              ))
            }
          </g>
        </svg>
      </div>
      <p class="swipe-hint">Swipe sideways to see the whole timeline.</p>
    </div>

    <aside class="panel" aria-live="polite">
      <div class="panel-empty">
        <h2>How to read this map</h2>
        <ul>
          <li>Left to right is time: the ancient world on the left, the modern age on the right.</li>
          <li>Each row is a school of thought.</li>
          <li><strong>Solid lines</strong> show influence; <strong>thin lines</strong>, thinkers who stood together; <strong>dashed lines</strong>, arguments.</li>
          <li>Choose a thinker to see everyone they were in conversation with.</li>
        </ul>
      </div>
      <div class="panel-body" hidden></div>
    </aside>
  </div>

  <script type="application/json" id="map-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</BaseLayout>

<script>
  interface Connection {
    id: string;
    name: string;
    stance: string;
    note?: string;
  }
  interface Entry {
    name: string;
    dates: string;
    ideology: string;
    color: string;
    summary: string;
    url: string;
    connections: Connection[];
  }
  const data = JSON.parse(document.getElementById('map-data')!.textContent!) as {
    labels: Record<string, string>;
    thinkers: Record<string, Entry>;
  };

  const svg = document.querySelector<SVGSVGElement>('svg.map')!;
  const nodes = Array.from(svg.querySelectorAll<SVGAElement>('.node'));
  const edges = Array.from(svg.querySelectorAll<SVGPathElement>('.edge'));
  const empty = document.querySelector<HTMLElement>('.panel-empty')!;
  const body = document.querySelector<HTMLElement>('.panel-body')!;
  let selected: string | null = null;

  // With the script running, a dot selects instead of navigating.
  for (const n of nodes) {
    n.setAttribute('role', 'button');
    n.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      select(n.dataset.id === selected ? null : n.dataset.id!);
    });
    n.addEventListener('keydown', (e) => {
      if (e.key === ' ') {
        e.preventDefault();
        select(n.dataset.id!);
      }
    });
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, cls?: string) {
    const node = document.createElement(tag);
    if (text) node.textContent = text;
    if (cls) node.className = cls;
    return node;
  }

  function renderPanel(id: string) {
    const t = data.thinkers[id]!;
    body.replaceChildren();
    body.style.setProperty('--accent', t.color);

    body.append(el('p', `${t.ideology} · ${t.dates}`, 'panel-meta'));
    body.append(el('h2', t.name));
    body.append(el('p', t.summary, 'panel-summary'));
    const read = el('a', 'Read the lesson →', 'panel-read');
    read.href = t.url;
    body.append(read);

    const groups = new Map<string, Connection[]>();
    for (const c of t.connections) groups.set(c.stance, [...(groups.get(c.stance) ?? []), c]);
    for (const [stance, items] of groups) {
      const group = el('section', undefined, `group ${stance}`);
      group.append(el('h3', data.labels[stance]));
      const list = el('ul');
      for (const c of items) {
        const li = el('li');
        const btn = el('button', c.name, 'jump');
        btn.type = 'button';
        btn.addEventListener('click', () => select(c.id, true));
        li.append(btn);
        if (c.note) li.append(el('p', c.note));
        list.append(li);
      }
      group.append(list);
      body.append(group);
    }
  }

  function select(id: string | null, scrollIntoView = false) {
    selected = id && data.thinkers[id] ? id : null;
    svg.classList.toggle('has-selection', !!selected);
    const neighbours = new Set<string>();
    for (const e of edges) {
      const lit = !!selected && (e.dataset.a === selected || e.dataset.b === selected);
      e.classList.toggle('lit', lit);
      if (lit) neighbours.add(e.dataset.a!).add(e.dataset.b!);
    }
    for (const n of nodes) {
      n.classList.toggle('lit', neighbours.has(n.dataset.id!) || n.dataset.id === selected);
      n.classList.toggle('current', n.dataset.id === selected);
    }
    if (selected) {
      svg.style.setProperty('--sel', data.thinkers[selected]!.color);
      renderPanel(selected);
      history.replaceState(null, '', `#${selected}`);
      if (scrollIntoView) {
        nodes
          .find((n) => n.dataset.id === selected)
          ?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      }
    } else {
      history.replaceState(null, '', location.pathname);
    }
    empty.hidden = !!selected;
    body.hidden = !selected;
  }

  svg.addEventListener('click', () => select(null));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && selected) select(null);
  });

  for (const chip of document.querySelectorAll<HTMLButtonElement>('.filters .chip')) {
    chip.addEventListener('click', () => {
      const on = chip.getAttribute('aria-pressed') !== 'true';
      chip.setAttribute('aria-pressed', String(on));
      svg.classList.toggle(`hide-${chip.dataset.kind}`, !on);
    });
  }

  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial) select(initial, true);
</script>

<style>
  .intro {
    padding-top: 2.5rem;
  }

  .intro h1 {
    margin-bottom: 0.5rem;
  }

  .intro .lede {
    max-width: var(--measure);
  }

  .map-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2rem;
    padding-top: 1rem;
    align-items: start;
  }

  .map-col {
    min-width: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font: 500 0.82rem var(--font-sans);
    cursor: pointer;
  }

  .chip[aria-pressed='false'] {
    opacity: 0.5;
    text-decoration: line-through;
  }

  .swatch {
    width: 22px;
    height: 0;
    border-top: 2.5px solid var(--ink-soft);
  }

  .chip.agreed .swatch {
    border-top-width: 1.5px;
  }

  .chip.argued .swatch {
    border-top-style: dashed;
  }

  .scroller {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    -webkit-overflow-scrolling: touch;
  }

  .map {
    display: block;
    width: 100%;
    min-width: 720px;
    height: auto;
    font-family: var(--font-sans);
  }

  .axis line {
    stroke: var(--rule);
    stroke-dasharray: 2 4;
  }

  .axis text {
    fill: var(--muted);
    font-size: 11px;
    text-anchor: middle;
  }

  .axis .break {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
  }

  .band {
    fill: color-mix(in srgb, var(--ink) 3%, transparent);
  }

  .row-label {
    fill: var(--row);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .row-label.right {
    text-anchor: end;
  }

  .edge {
    fill: none;
    stroke: color-mix(in srgb, var(--muted) 55%, transparent);
    stroke-width: 1.6;
    transition: opacity 0.15s ease, stroke 0.15s ease;
  }

  .edge.agreed {
    stroke-width: 1;
  }

  .edge.argued {
    stroke-dasharray: 5 4;
  }

  .hide-influence .edge.influence,
  .hide-agreed .edge.agreed,
  .hide-argued .edge.argued {
    display: none;
  }

  .has-selection .edge {
    opacity: 0.08;
  }

  .has-selection .edge.lit {
    opacity: 1;
    stroke: var(--sel);
    stroke-width: 2.2;
  }

  .has-selection .edge.agreed.lit {
    stroke-width: 1.4;
  }

  .node {
    cursor: pointer;
    outline: none;
    transition: opacity 0.15s ease;
  }

  .node .halo {
    fill: transparent;
  }

  .node .dot {
    fill: var(--dot);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .node text {
    fill: var(--ink);
    font-size: 11.5px;
    font-weight: 500;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .node:hover .halo,
  .node:focus-visible .halo {
    fill: color-mix(in srgb, var(--dot) 22%, transparent);
  }

  .node:focus-visible .halo {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .has-selection .node {
    opacity: 0.25;
  }

  .has-selection .node.lit {
    opacity: 1;
  }

  .node.current .halo {
    fill: color-mix(in srgb, var(--dot) 30%, transparent);
    stroke: var(--dot);
    stroke-width: 2;
  }

  .node.current text {
    font-weight: 700;
  }

  .swipe-hint {
    display: none;
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .panel {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.9rem;
  }

  .panel h2 {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }

  .panel-empty ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }

  .panel-empty li {
    margin-bottom: 0.45rem;
  }

  .panel :global(.panel-meta) {
    margin: 0 0 0.2rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel :global(.panel-summary) {
    margin: 0 0 0.6rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .panel :global(.panel-read) {
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .panel :global(.group) {
    margin-bottom: 0.9rem;
    padding-left: 0.7rem;
    border-left: 3px solid var(--accent);
  }

  .panel :global(.group.challenged),
  .panel :global(.group.challenged-by) {
    border-left-style: dashed;
    border-left-color: var(--rule);
  }

  .panel :global(.group h3) {
    margin: 0 0 0.3rem;
    font: 600 0.78rem var(--font-sans);
    color: var(--ink-soft);
  }

  .panel :global(.group ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .panel :global(.group li) {
    padding: 0.25rem 0;
  }

  .panel :global(.jump) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link, var(--ink));
    font: 1.02rem var(--font-serif);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .panel :global(.group p) {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .map-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .panel {
      position: static;
      max-height: none;
    }

    .swipe-hint {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge,
    .node {
      transition: none;
    }
  }
</style>
