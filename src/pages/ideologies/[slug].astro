---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThinkerCard from '../../components/ThinkerCard.astro';
import IdeologyChip from '../../components/IdeologyChip.astro';
import {
  getAssociatedThinkers,
  getCoreThinkers,
  getIdeologies,
  getIdeologyMap,
  type Ideology,
} from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const ideologies = await getIdeologies();
  return ideologies.map((ideology) => ({ params: { slug: ideology.id }, props: { ideology } }));
}

interface Props {
  ideology: Ideology;
}

const { ideology } = Astro.props;
const { Content } = await render(ideology);
const core = await getCoreThinkers(ideology.id);
const associated = await getAssociatedThinkers(ideology.id);
const ideologyMap = await getIdeologyMap();
const others = (await getIdeologies()).filter((i) => i.id !== ideology.id);
---

<BaseLayout title={ideology.data.name} description={ideology.data.summary}>
  <div style={`--accent: ${ideology.data.color}`}>
    <header class="hero">
      <div class="container">
        <p class="eyebrow"><a href={url('/ideologies/')}>Ideologies</a></p>
        <h1>{ideology.data.name}</h1>
        <p class="lede">{ideology.data.summary}</p>
      </div>
    </header>

    <div class="container">
      <section aria-labelledby="core-heading">
        <div class="section-head">
          <h2 id="core-heading">Core thinkers</h2>
        </div>
        {
          core.length > 0 ? (
            <div class="grid">
              {core.map((t) => (
                <ThinkerCard thinker={t} primary={ideology} showIdeology={false} />
              ))}
            </div>
          ) : (
            <p class="none">No thinkers are listed under this ideology yet.</p>
          )
        }
      </section>

      {
        associated.length > 0 && (
          <section aria-labelledby="assoc-heading">
            <div class="section-head">
              <h2 id="assoc-heading">Also associated</h2>
              <p class="hint">Thinkers listed elsewhere who shaped or belong to this tradition.</p>
            </div>
            <div class="grid">
              {associated.map((t) => (
                <ThinkerCard thinker={t} primary={ideologyMap.get(t.data.primary.id)!} />
              ))}
            </div>
          </section>
        )
      }

      <section class="overview" aria-labelledby="overview-heading">
        <div class="section-head">
          <h2 id="overview-heading">Overview</h2>
        </div>
        <div class="prose">
          <Content />
        </div>
      </section>

      <nav class="others" aria-label="Other ideologies" data-pagefind-ignore>
        <h2>Other schools of thought</h2>
        <div class="chips">
          {others.map((i) => <IdeologyChip ideology={i} />)}
        </div>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 16%, var(--bg)) 0%,
      var(--bg) 100%
    );
    border-bottom: 1px solid var(--rule);
    border-top: 6px solid var(--accent);
    padding: 3rem 0 2.25rem;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .none {
    color: var(--muted);
    font-style: italic;
  }

  .overview .prose :global(h2) {
    font-size: 1.45rem;
  }

  .others {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .others h2 {
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
