---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Monogram from '../../components/Monogram.astro';
import IdeologyChip from '../../components/IdeologyChip.astro';
import QuoteBlock from '../../components/QuoteBlock.astro';
import ConnectionList from '../../components/ConnectionList.astro';
import { getConnections, getIdeologyMap, getThinkers, type Thinker } from '../../lib/content';
import { formatLifespan } from '../../lib/format';
import { ideologyUrl, thinkerUrl, url } from '../../lib/url';

export async function getStaticPaths() {
  const thinkers = await getThinkers();
  return thinkers.map((thinker, i) => ({
    params: { slug: thinker.id },
    props: {
      thinker,
      prev: thinkers[i - 1],
      next: thinkers[i + 1],
    },
  }));
}

interface Props {
  thinker: Thinker;
  prev?: Thinker | undefined;
  next?: Thinker | undefined;
}

const { thinker, prev, next } = Astro.props;
const d = thinker.data;
const ideologies = await getIdeologyMap();
const primary = ideologies.get(d.primary.id)!;
const tags = d.tags.map((t) => ideologies.get(t.id)!);
const { influencedBy, influenced } = await getConnections(thinker);
const { Content } = await render(thinker);
const [featuredQuote, ...otherQuotes] = d.quotes;
---

<BaseLayout title={d.name} description={d.summary}>
  <article class="thinker" style={`--accent: ${primary.data.color}`}>
    <header class="hero">
      <div class="container hero-inner">
        <Monogram name={d.name} color={primary.data.color} size="lg" />
        <div>
          <p class="eyebrow">
            <a href={url('/ideologies/')}>Ideologies</a>
            <span aria-hidden="true">&nbsp;/&nbsp;</span>
            <a href={ideologyUrl(primary.id)}>{primary.data.name}</a>
          </p>
          <h1>{d.name}</h1>
          <p class="meta">
            <span>{formatLifespan(d)}</span>
            <span aria-hidden="true">·</span>
            <span>{d.region}</span>
            <span aria-hidden="true">·</span>
            <span>{d.era}</span>
          </p>
          <p class="lede">{d.summary}</p>
          <div class="chips" data-pagefind-ignore>
            <IdeologyChip ideology={primary} />
            {tags.map((tag) => <IdeologyChip ideology={tag} />)}
          </div>
        </div>
      </div>
    </header>

    <div class="container layout">
      <div class="main-col">
        {
          featuredQuote && (
            <QuoteBlock text={featuredQuote.text} source={featuredQuote.source} featured />
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          otherQuotes.length > 0 && (
            <section class="quotes">
              <h2>In their words</h2>
              {otherQuotes.map((q) => (
                <QuoteBlock text={q.text} source={q.source} />
              ))}
            </section>
          )
        }
      </div>

      <aside class="side" aria-label="About this thinker">
        {
          d.keyWorks.length > 0 && (
            <section>
              <h3 class="side-title">Key works</h3>
              <ul class="works">
                {d.keyWorks.map((w) => (
                  <li>
                    <cite>{w.title}</cite>
                    {w.year && <span>{w.year}</span>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div data-pagefind-ignore>
          <ConnectionList title="Influenced by" thinkers={influencedBy} />
          <ConnectionList title="Influenced" thinkers={influenced} />

          <section>
            <h3 class="side-title">Sources and further reading</h3>
            <ul class="sources">
              {
                d.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener">
                      {s.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <p class:list={['status', { reviewed: d.reviewed }]}>
            {
              d.reviewed
                ? 'This profile has been reviewed by an editor.'
                : 'Draft profile: not yet reviewed by an editor. Check the sources above before citing.'
            }
          </p>
        </div>
      </aside>
    </div>

    <nav class="container pager" aria-label="More thinkers" data-pagefind-ignore>
      {
        prev ? (
          <a href={thinkerUrl(prev.id)} rel="prev">
            <span>← Previous</span>
            {prev.data.name}
          </a>
        ) : (
          <span />
        )
      }
      <a class="all" href={url('/thinkers/')}>All thinkers</a>
      {
        next ? (
          <a href={thinkerUrl(next.id)} rel="next" class="next">
            <span>Next →</span>
            {next.data.name}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 14%, var(--bg)) 0%,
      var(--bg) 100%
    );
    border-bottom: 1px solid var(--rule);
    padding: 3rem 0 2.25rem;
  }

  .hero-inner {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    padding-top: 2.5rem;
  }

  .main-col {
    min-width: 0;
  }

  .main-col > :global(.quote) {
    margin-bottom: 2rem;
  }

  .quotes {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
  }

  .quotes h2 {
    margin-bottom: 0.25rem;
  }

  .side {
    position: sticky;
    top: 80px;
    align-self: start;
    font-size: 0.92rem;
  }

  .side-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .works,
  .sources {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .works li {
    display: flex;
    flex-direction: column;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .works cite {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
  }

  .works span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .sources li {
    padding: 0.3rem 0;
  }

  .status {
    padding: 0.7rem 0.85rem;
    border: 1px dashed var(--rule);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .status.reviewed {
    border-style: solid;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    text-decoration: none;
  }

  .pager a span {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pager .next {
    text-align: right;
  }

  .pager .all {
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .side {
      position: static;
      border-top: 1px solid var(--rule);
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 2rem;
    }

    .hero-inner {
      flex-direction: column;
      gap: 1rem;
    }

    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager .all {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
  }
</style>
