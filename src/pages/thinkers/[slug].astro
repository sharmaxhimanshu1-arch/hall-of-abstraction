---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Monogram from '../../components/Monogram.astro';
import IdeologyChip from '../../components/IdeologyChip.astro';
import QuoteBlock from '../../components/QuoteBlock.astro';
import ConnectionList from '../../components/ConnectionList.astro';
import ConversationList from '../../components/ConversationList.astro';
import PageContents from '../../components/PageContents.astro';
import {
  getConnections,
  getConversations,
  getIdeologyMap,
  getThinkers,
  readingMinutes,
  type Thinker,
} from '../../lib/content';
import { formatLifespan } from '../../lib/format';
import { ideologyUrl, thinkerUrl, url } from '../../lib/url';

export async function getStaticPaths() {
  const thinkers = await getThinkers();
  return thinkers.map((thinker, i) => ({
    params: { slug: thinker.id },
    props: {
      thinker,
      prev: thinkers[i - 1],
      next: thinkers[i + 1],
    },
  }));
}

interface Props {
  thinker: Thinker;
  prev?: Thinker | undefined;
  next?: Thinker | undefined;
}

const { thinker, prev, next } = Astro.props;
const d = thinker.data;
const ideologies = await getIdeologyMap();
const primary = ideologies.get(d.primary.id)!;
const tags = d.tags.map((t) => ideologies.get(t.id)!);
const { influencedBy, influenced } = await getConnections(thinker);
const conversations = await getConversations(thinker);
const { Content, headings } = await render(thinker);
const minutes = readingMinutes(thinker.body);
const [featuredQuote, ...otherQuotes] = d.quotes;
---

<BaseLayout title={d.name} description={d.summary}>
  <article class="thinker" style={`--accent: ${primary.data.color}`}>
    <div
      class="read-progress"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-pagefind-ignore
    >
      <span></span>
    </div>
    <div class="read-left" aria-hidden="true" data-pagefind-ignore data-minutes={minutes}></div>

    <header class="hero">
      <div class="container hero-inner">
        <Monogram name={d.name} color={primary.data.color} size="lg" />
        <div>
          <p class="eyebrow">
            <a href={url('/ideologies/')}>Ideologies</a>
            <span aria-hidden="true">&nbsp;/&nbsp;</span>
            <a href={ideologyUrl(primary.id)}>{primary.data.name}</a>
          </p>
          <h1>{d.name}</h1>
          <p class="meta">
            <span>{formatLifespan(d)}{d.datesNote && <em class="dates-note"> ({d.datesNote})</em>}</span>
            <span aria-hidden="true">·</span>
            <span>{d.region}</span>
            <span aria-hidden="true">·</span>
            <span>{d.era}</span>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </p>
          <p class="lede">{d.summary}</p>
          <div class="chips" data-pagefind-ignore>
            <IdeologyChip ideology={primary} />
            {tags.map((tag) => <IdeologyChip ideology={tag} />)}
          </div>
        </div>
      </div>
    </header>

    <div class="container layout">
      <div class="main-col">
        <div class="contents-mobile" data-pagefind-ignore>
          <PageContents headings={headings} collapsible />
        </div>

        {
          featuredQuote && (
            <QuoteBlock text={featuredQuote.text} source={featuredQuote.source} featured />
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          otherQuotes.length > 0 && (
            <section class="quotes">
              <h2>In their words</h2>
              {otherQuotes.map((q) => (
                <QuoteBlock text={q.text} source={q.source} />
              ))}
            </section>
          )
        }
      </div>

      <aside class="side" aria-label="About this thinker">
        {
          d.keyWorks.length > 0 && (
            <section>
              <h3 class="side-title">Key works</h3>
              <ul class="works">
                {d.keyWorks.map((w) => (
                  <li>
                    <cite>{w.title}</cite>
                    {w.year && <span>{w.year}</span>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div data-pagefind-ignore>
          {
            conversations.length > 0 ? (
              <ConversationList groups={conversations} />
            ) : (
              <>
                <ConnectionList title="Influenced by" thinkers={influencedBy} />
                <ConnectionList title="Influenced" thinkers={influenced} />
              </>
            )
          }

          <section>
            <h3 class="side-title">Sources and further reading</h3>
            <ul class="sources">
              {
                d.sources.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener">
                      {s.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <p class:list={['status', { reviewed: d.reviewed }]}>
            {
              d.reviewed
                ? 'This profile has been reviewed by an editor.'
                : 'Draft profile: not yet reviewed by an editor. Check the sources above before citing.'
            }
          </p>
        </div>

        <div class="contents-desktop" data-pagefind-ignore>
          <PageContents headings={headings} />
        </div>
      </aside>
    </div>

    <nav class="container pager" aria-label="More thinkers" data-pagefind-ignore>
      {
        prev ? (
          <a href={thinkerUrl(prev.id)} rel="prev">
            <span>← Previous</span>
            {prev.data.name}
          </a>
        ) : (
          <span />
        )
      }
      <a class="all" href={url('/thinkers/')}>All thinkers</a>
      {
        next ? (
          <a href={thinkerUrl(next.id)} rel="next" class="next">
            <span>Next →</span>
            {next.data.name}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  // Highlight the section currently being read in the desktop contents list.
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('.contents-desktop a[data-slug]')).map(
      (a) => [a.dataset.slug!, a],
    ),
  );
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id]')).filter(
    (h) => links.has(h.id),
  );

  // Reading progress, measured over the lesson text only.
  const prose = document.querySelector<HTMLElement>('.prose');
  const bar = document.querySelector<HTMLElement>('.read-progress');
  const fill = bar?.querySelector<HTMLElement>('span');
  const left = document.querySelector<HTMLElement>('.read-left');
  const minutes = Number(left?.dataset.minutes) || 0;

  const updateProgress = () => {
    if (!prose || !bar || !fill || !left) return;
    const rect = prose.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / rect.height));
    const pct = Math.round(p * 100);
    fill.style.transform = `scaleX(${p})`;
    bar.setAttribute('aria-valuenow', String(pct));
    left.textContent =
      pct >= 98 ? 'Done' : `${pct}% · ${Math.max(1, Math.ceil(minutes * (1 - p)))} min left`;
    left.classList.toggle('visible', p > 0.02);
  };

  const updateSections = () => {
    if (!sections.length) return;
    // The current section is the last heading above the middle of the screen.
    const current =
      [...sections].reverse().find((h) => h.getBoundingClientRect().top < window.innerHeight / 2)
        ?.id ?? sections[0]!.id;
    for (const [slug, a] of links) a.setAttribute('aria-current', String(slug === current));
  };

  let pending = false;
  const update = () => {
    pending = false;
    updateProgress();
    updateSections();
  };
  const schedule = () => {
    if (!pending) {
      pending = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 10;
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .read-left {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .read-left:global(.visible) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .read-left {
      transition: none;
    }
  }

  @media print {
    .read-progress,
    .read-left {
      display: none;
    }
  }

  .hero {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 14%, var(--bg)) 0%,
      var(--bg) 100%
    );
    border-bottom: 1px solid var(--rule);
    padding: 3rem 0 2.25rem;
  }

  .hero-inner {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }

  .dates-note {
    font-style: normal;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    padding-top: 2.5rem;
  }

  .main-col {
    min-width: 0;
  }

  .main-col > :global(.quote) {
    margin-bottom: 2rem;
  }

  .quotes {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
  }

  .quotes h2 {
    margin-bottom: 0.25rem;
  }

  .side {
    font-size: 0.92rem;
  }

  /* The sidebar stretches the full article height; the contents list sticks
     once the reader scrolls past the sidebar's other sections. */
  .contents-desktop {
    position: sticky;
    top: 80px;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .contents-mobile {
    display: none;
  }

  /* "The shift" closing section, wrapped in <div class="shift"> in Markdown. */
  .prose :global(.shift) {
    margin: 2.5rem 0;
    padding: 0.5rem 1.5rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-left-width: 5px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }

  .prose :global(.shift h2) {
    border-bottom: 0;
    margin-top: 1rem;
  }

  .prose :global(h2) {
    scroll-margin-top: 80px;
  }

  .side-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .works,
  .sources {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .works li {
    display: flex;
    flex-direction: column;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .works cite {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
  }

  .works span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .sources li {
    padding: 0.3rem 0;
  }

  .status {
    padding: 0.7rem 0.85rem;
    border: 1px dashed var(--rule);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .status.reviewed {
    border-style: solid;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    text-decoration: none;
  }

  .pager a span {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pager .next {
    text-align: right;
  }

  .pager .all {
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .side {
      border-top: 1px solid var(--rule);
      padding-top: 1.5rem;
    }

    .contents-desktop {
      display: none;
    }

    .contents-mobile {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .read-left {
      right: auto;
      left: 50%;
      bottom: 0.75rem;
      transform: translateX(-50%);
    }

    .hero {
      padding-top: 2rem;
    }

    .hero-inner {
      flex-direction: column;
      gap: 1rem;
    }

    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager .all {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
  }
</style>
